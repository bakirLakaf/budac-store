# ===== عام =====
# نفس قاعدة بيانات المتجر (الأداة تنشئ جداولها الخاصة بسابقة sp_)
DATABASE_URL=postgresql://user:password@localhost:5432/budac
# الرابط العام تاع المتجر (https) — فيسبوك وانستغرام يجبدو منو الصور والفيديو
SP_PUBLIC_BASE_URL=https://budacdz.com
# سر عشوائي طويل (32 حرف+) لتوقيع الروابط المؤقتة
SP_SECRET=
SP_ADMIN_PREFIX=/admin/social
SP_TEMP_DIR=sp_tmp
SP_MAX_VIDEO_MB=100
SP_MAX_IMAGE_MB=10
SP_TZ_OFFSET_HOURS=1
# رابط صفحة المنتج في المتجر ({slug} يتبدل بالرابط تاع المنتج)
SHOP_PRODUCT_URL_TEMPLATE=https://budacdz.com/product/{slug}
# مجلد صور المتجر في السيرفر وبداية رابطها العام (للـ BudacAdapter)
BUDAC_UPLOADS_DIR=static/uploads
BUDAC_UPLOADS_URL=/static/uploads

# ===== فيسبوك + انستغرام (Meta) =====
META_GRAPH_VERSION=v26.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# اختياري: لو فارغ نستعملو FB_PAGE_TOKEN
IG_ACCESS_TOKEN=

# ===== تيك توك =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# لازم نفس الـ Redirect URI المسجل في TikTok Developers
TIKTOK_REDIRECT_URI=https://budacdz.com/admin/social/tiktok/callback
# inbox = مسودة تكملها في تطبيق تيك توك (الأضمن) | direct = نشر مباشر (يحتاج audit)
TIKTOK_MODE=inbox
TIKTOK_PRIVACY=SELF_ONLY

# ===== للتشغيل التجريبي المستقل (run_standalone.py) برك =====
ADMIN_PASSWORD=
PRODUCTS_XLSX=budac-products.xlsx
