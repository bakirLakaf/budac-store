# انسخ هذا الملف لـ .env وعمّر القيم — ملف .env ما يترفعش لـGit أبدًا
SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///budac.db
FLASK_ENV=development

STORE_NAME=BUDAC
STORE_TAGLINE=ديكور و إكسسوارات

# رقم الواتساب بصيغة دولية بلا + ولا مسافات
WHATSAPP_NUMBER=213676672334

# بيكسلات الإعلانات (اختيارية — خليهم فارغين إذا ما تعلنش)
FACEBOOK_PIXEL_ID=
TIKTOK_PIXEL_ID=

# ---------- YouCan Admin API (اختياري) ----------
# التوكن يعطي بيانات أغنى: التصنيفات + التنويعات بأسعارها ومخزونها.
# بلاه، الاستيراد يخدم عادي لكن التنويعات ترث سعر المنتج الأساسي.
# احصل عليه من: لوحة تحكم YouCan ← الإعدادات ← API / تطبيقات
YOUCAN_ACCESS_TOKEN=

# ---------- ZR Express API (اختياري) ----------
# يخليك تبعث الطلبيات لـZR بنقرة، وتجيك أرقام التتبّع تلقائيًا.
# احصل عليهم من: حسابك عند ZR Express ← Documentation API ← Jetons API
ZR_TENANT_ID=
ZR_API_KEY=
