# ══════════════════════════════════════════════════════════════
# BUDAC Store — متغيرات البيئة
# انسخ هاد الملف لـ.env وعمّرو. .env ما يتبعثش لـGit (فـ.gitignore).
# ══════════════════════════════════════════════════════════════

# 🔴 إجباري — التطبيق ما يقلعش بلاه فالإنتاج.
# ولّد واحدًا عشوائيًا بهاد الأمر:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ تبديلو يبطّل كل الجلسات المفتوحة (وهذا مطلوب بعد أي اختراق).
SECRET_KEY=

# قاعدة البيانات. Railway يعمّرها تلقائيًا.
# محليًا: sqlite:///budac.db
DATABASE_URL=

# ══════════════════════════════════════════════════════════════
# التطوير المحلي
# ══════════════════════════════════════════════════════════════
# حط development باش:
#   • SECRET_KEY يولّي اختياريًا
#   • كوكي الجلسة يمشي على http (بلاها لازم https)
# ⚠️ ما تحطّهاش أبدًا فالإنتاج.
FLASK_ENV=

# ══════════════════════════════════════════════════════════════
# المتجر
# ══════════════════════════════════════════════════════════════
STORE_NAME=BUDAC
STORE_TAGLINE=ديكور و إكسسوارات
WHATSAPP_NUMBER=213676672334

# ⚠️ مجلد الصور. على Railway: ركّب Volume وحط المسار هنا (/data)،
# وإلا الصور تتمسح مع كل نشر.
UPLOAD_ROOT=

# ══════════════════════════════════════════════════════════════
# ZR Express
# ══════════════════════════════════════════════════════════════
ZR_TENANT_ID=
ZR_API_KEY=

# ══════════════════════════════════════════════════════════════
# بيكسلات الإعلانات (اختيارية)
# ══════════════════════════════════════════════════════════════
FACEBOOK_PIXEL_ID=
TIKTOK_PIXEL_ID=

# ══════════════════════════════════════════════════════════════
# إشعارات Telegram (اختيارية) — طلبية جديدة / تقييم جديد
# شوف services/telegram.py لخطوات الإعداد كاملة
# ══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ══════════════════════════════════════════════════════════════
# حساب الأدمن الأول — يتخلق عند أول تشغيل برك
# ══════════════════════════════════════════════════════════════
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ══════════════════════════════════════════════════════════════
# متقدّم
# ══════════════════════════════════════════════════════════════

# تخزين حدود المعدّل. الافتراضي memory:// (كافي لعامل واحد).
# كي تزيد WEB_WORKERS، بدّلها لـredis://... وإلا كل عامل عندو عدّادو.
RATELIMIT_STORAGE_URI=

# عدد عمال gunicorn. خلّيه 1 إلا إذا حطّيت Redis فوق.
WEB_WORKERS=1

# 🔴 خطير: يسمح لـstartup.py يعيد بناء جدولي البلديات (يمسحهم).
# يمسح كذلك نتيجة مزامنة ZR. حطّو yes مرة وحدة عند الحاجة برك،
# وخذ نسخة احتياطية قبل. حيّدو بعد النشر.
ALLOW_COMMUNES_REBUILD=

# يجبر كوكي الجلسة يكون Secure/غير Secure. اتركو فارغًا —
# الافتراضي يتحدد من FLASK_ENV وهو الصحيح.
SESSION_COOKIE_SECURE=

# ── World Express (منصة ECOTRACK) ──
# التوكن: لوحة ECOTRACK ← API ← «Voir Token». ⚠️ سرّي — ما يتشاركش.
WORLD_API_TOKEN=
# اختياري — الافتراضي https://world-express.ecotrack.dz
# WORLD_BASE_URL=https://world-express.ecotrack.dz
# «1» = يأكّد الإرسال (Expédier) تلقائيًا بعد الإنشاء. الافتراضي «0»: الأدمن يضغط الزر.
WORLD_AUTO_VALIDATE=0

# ── Yalidine Express (API رسمي v1) ──
# من لوحة Yalidine ← API. ⚠️ سرّيين — ما يتشاركوش (ولا يتصوّرو).
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
# ولايتك (المرسل) بالحروف اللاتينية كيما فقائمة Yalidine: Batna / Alger / Oran...
YALIDINE_FROM_WILAYA=
# «1» (افتراضي): السعر المبعوث = مجموع الطلبية (يشمل التوصيل)، والزبون يدفعو كيما هو.
# «0»: الزبون يدفع السعر + ثمن التوصيل (يتزاد فوقو).
YALIDINE_FREESHIPPING=0
# «1» يفعّل التأمين (1.5% من القيمة). الافتراضي 0
YALIDINE_INSURANCE=0
# مقاسات الطرد الافتراضية (كغ / سم) — Yalidine تطلبهم إجباري
YALIDINE_WEIGHT=1
YALIDINE_LENGTH=20
YALIDINE_WIDTH=15
YALIDINE_HEIGHT=10

# ---------- v181: واتساب التلقائي (Cloud API الرسمي) — شوف WHATSAPP_SETUP.md ----------
# بلا WA_CLOUD_TOKEN و WA_PHONE_NUMBER_ID الإرسال التلقائي مطفي والأزرار اليدوية تبقى تخدم.
SITE_URL=https://budacdz.com
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# اختياري: لغة القوالب (ar) وأسماء القوالب إذا سمّيتهم بشكل آخر عند Meta
# WA_TEMPLATE_LANG=ar
# WA_TPL_CONFIRM=budac_order_confirm
# WA_TPL_SHIPPED=budac_order_shipped
# WA_TPL_ARRIVED=budac_order_arrived
# WA_TPL_THANKS=budac_order_delivered

# ---------- v181: مهام الخلفية ----------
# كل كم دقيقة نسقسيو شركات التوصيل على حالة الطلبيات (الافتراضي 20)
# TRACKING_SYNC_MINUTES=20
# BACKGROUND_JOBS=0   # يوقف الخيط الخلفي (مثلاً إذا تستعمل cron خارجي فقط)
# JOBS_SECRET=        # 16 حرف على الأقل — يفتح /internal/jobs/run?key=... لـcron خارجي
